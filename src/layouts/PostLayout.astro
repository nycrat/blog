---
import BaseLayout from "./BaseLayout.astro";
import "../styles/post.css";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title + " · blog.nycrat.dev"}>
  <div class="meta">
    <h1>{frontmatter.title}</h1>
    <blockquote>{frontmatter.subtitle}</blockquote>
    <div class="date">
      Published {frontmatter.date}
    </div>
  </div>

  <slot />
</BaseLayout>

<style>
  .date {
    font-style: italic;
    color: var(--gray);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
</style>
