---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Post } from "../types/post";

const posts = Object.values(
	import.meta.glob("./posts/*.mdx", { eager: true }),
) as Post[];

const thumbnails = import.meta.glob("./posts/images/**/*.{png,jpg,webp}", {
	eager: true,
}) as Record<string, { default: ImageMetadata }>;
---

<BaseLayout pageTitle="Posts · blog.nycrat.dev">
	{
		posts
			.toSorted((a, b) => {
				const dateA = new Date(a.frontmatter.date);
				const dateB = new Date(b.frontmatter.date);
				return dateB.getTime() - dateA.getTime();
			})
			.map((post) => (
				<div class="post">
					<h1>
						<a href={post.url}>{post.frontmatter.title}</a>
					</h1>
					<blockquote>{post.frontmatter.subtitle}</blockquote>
					<span class="meta">
						{post.frontmatter.date} ~
						<ul>
							{post.frontmatter.tags.map((tag: string) => (
								<li>{tag}</li>
							))}
						</ul>
					</span>
					{post.frontmatter.thumbnail &&
						thumbnails[post.frontmatter.thumbnail] && (
							<Image
								src={thumbnails[post.frontmatter.thumbnail].default}
								alt={post.frontmatter.title}
							/>
						)}
				</div>
			))
	}
</BaseLayout>

<style>
	.post {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding-bottom: 30px;
		border-bottom: 1px solid var(--lightgray);
	}

	.post:last-child {
		border-bottom: none;
	}

	.meta {
		color: var(--gray);
	}

	ul,
	li {
		list-style-type: none;
		display: inline;
	}

	li:nth-last-child(n + 2)::after {
		padding: 0 5px;
		content: "\00b7";
	}

	img {
		border: 1px solid var(--gray);
		max-width: 100%;
		height: auto;
		aspect-ratio: 3/2;
		object-fit: cover;
	}

	@media screen and (min-width: 600px) {
		img {
			aspect-ratio: 16/9;
		}
	}
</style>
